{
  "name": "pomodoro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --workspaces --parallel --if-present dev",
    "db:migrate": "cargo run --locked -p pomodoro-migration -- up",
    "build": "bun run --workspaces --if-present build",
    "lint": "bun run --workspaces lint",
    "lint:fix": "bun run --workspaces lint:fix",
    "format:check": "bun run --workspaces format:check",
    "format:write": "bun run --workspaces format:write",
    "typecheck": "bun run --workspaces typecheck"
  },
  "devDependencies": {
    "@yopem-ui/oxlint-plugin": "^0.1.2",
    "@yopem/eslint-plugin": "^0.1.0",
    "@yopem/typescript-config": "^0.2.5",
    "eslint-plugin-oxfmt": "^0.26.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  },
  "overrides": {
    "workbox-build@7.4.1>glob": "^14.0.4"
  }
}
