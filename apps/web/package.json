{
  "name": "@pomodoro/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 13001 --strictPort",
    "build": "vite build",
    "start": "NITRO_HOST=127.0.0.1 NITRO_PORT=13001 bun .output/server/index.mjs",
    "lint": "bun lint --no-script",
    "lint:fix": "bun lint --no-script --fix",
    "format:check": "bun fmt --no-script --check",
    "format:write": "bun fmt --no-script",
    "typecheck": "bun run routes:generate && bun check --no-script -p tsconfig.json && bun check --no-script -p tsconfig.tools.json && bun check --no-script -p src/service-worker/tsconfig.json",
    "routes:generate": "bun scripts/generate-routes.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@pomodoro/api": "workspace:*",
    "@pomodoro/env": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@tanstack/router-generator": "^1.167.46",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@yopem-ui/oxlint-plugin": "^0.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "nitro": "^3.0.261103-rc",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
