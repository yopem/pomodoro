{
  "name": "@pomodoro/api",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "lint": "bun lint --no-script",
    "lint:fix": "bun lint --no-script --fix",
