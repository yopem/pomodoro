    "format:write": "bun fmt --no-script",
    "typecheck": "bun check --no-script -p tsconfig.json && bun check --no-script -p tsconfig.tools.json"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
